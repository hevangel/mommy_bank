# Copy to .env and fill in real values — never commit real passwords.
# First-boot admin password (if unset, a random one is printed once in the logs)
MOMMYBANK_ADMIN_PASSWORD=change-me
# JWT signing secret (if unset, one is generated and stored in the database)
MOMMYBANK_SECRET=change-me-to-a-long-random-string
# Seed demo kids (teen / kid / toddler) on first boot
MOMMYBANK_SEED_DEMO=0
MOMMYBANK_DEMO_PASSWORD=change-me
# Natural-log timezone; exchange-rule windows use the app "timezone" setting
TZ=UTC
